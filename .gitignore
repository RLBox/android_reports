.env
.venv/
.pytest_cache/
avd/*
!avd/.gitkeep
build/
dist/
__pycache__/
*.egg-info/
*.pyc
.DS_Store

# Docker images (HUGE files - 3GB total)
images/*.tar
!images/README.md

# APK files (generated artifacts)
apks/*.apk
!apks/.gitkeep
!apks/README.md
# Pass@3 per-task 实时回填的 pending 队列（本地状态不应入仓库）
.pending_feishu_writes.jsonl
**/.pending_feishu_writes.jsonl
.worktrees/

# Brand task session sidecar (AVD-bypass verify)
# 容器/host 通过 /workspace/taskset bind mount 共享的运行时元数据
.task_sessions/
logs/*
tmp/*
src/android_tasks_external/tasks/definitions/*
# skill cache (managed by skill-add)
.agents/
skills-lock.json
